{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // node types are for the test files only, which read fixtures off disk.
    // Nothing in src/ may import node, or core stops being isomorphic.
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
